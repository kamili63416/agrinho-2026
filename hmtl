<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Campo Sustentável | Soluções & Equipamentos Verdes</title>
  <!-- Google Fonts e estilos modernos -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <!-- Font Awesome 6 (gratuito) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: #f4f9ef;
      color: #1e2f2c;
      line-height: 1.5;
      scroll-behavior: smooth;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* header / navegação */
    .navbar {
      background: #1a3b2f;
      padding: 1rem 0;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    }

    .nav-flex {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #e9f5e1;
      font-weight: 700;
      font-size: 1.6rem;
      letter-spacing: -0.3px;
    }

    .logo i {
      font-size: 2rem;
      color: #c0e0a0;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      color: #e9f5e1;
      text-decoration: none;
      font-weight: 500;
      transition: 0.2s;
      font-size: 1rem;
    }

    .nav-links a:hover {
      color: #e0c87c;
      border-bottom: 2px solid #e0c87c;
      padding-bottom: 4px;
    }

    /* hero */
    .hero {
      background: linear-gradient(115deg, #e1f0da 0%, #cde2c1 100%);
      border-radius: 0 0 48px 48px;
      margin-bottom: 3rem;
      padding: 4rem 0 5rem;
    }

    .hero-grid {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 2rem;
      justify-content: space-between;
    }

    .hero-text {
      flex: 1;
    }

    .hero-text h1 {
      font-family: 'Playfair Display', serif;
      font-size: 3rem;
      font-weight: 600;
      color: #1a4d3a;
      margin-bottom: 1rem;
      line-height: 1.2;
    }

    .hero-text p {
      font-size: 1.2rem;
      color: #2c5a4a;
      margin-bottom: 1.8rem;
      max-width: 550px;
    }

    .btn-group {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #2d6a4f;
      color: white;
      padding: 0.8rem 1.8rem;
      border-radius: 60px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.2s;
      border: none;
      cursor: pointer;
    }

    .btn-outline {
      background: transparent;
      border: 2px solid #2d6a4f;
      color: #2d6a4f;
    }

    .btn-outline:hover {
      background: #2d6a4f;
      color: white;
    }

    .btn:hover {
      background: #1f543f;
      transform: translateY(-3px);
    }

    .hero-img {
      flex: 1;
      text-align: center;
    }

    .hero-img img {
      max-width: 100%;
      border-radius: 32px;
      box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.15);
    }

    /* cards de soluções */
    .section-title {
      text-align: center;
      font-size: 2.2rem;
      font-weight: 700;
      margin: 3rem 0 1rem;
      color: #1e4a3a;
      position: relative;
    }

    .section-sub {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 2.5rem;
      color: #446b5b;
      font-size: 1.1rem;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin: 2rem 0 3rem;
    }

    .card {
      background: white;
      border-radius: 32px;
      padding: 1.8rem;
      transition: all 0.25s ease;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
      border: 1px solid #dcf5cf;
    }

    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 30px -12px rgba(43, 86, 66, 0.2);
    }

    .card-icon {
      font-size: 2.8rem;
      color: #3b8b5e;
      margin-bottom: 1rem;
    }

    .card h3 {
      font-size: 1.6rem;
      margin-bottom: 1rem;
      font-weight: 600;
    }

    .card p {
      color: #2f4b40;
      margin-bottom: 1.2rem;
    }

    .tag {
      background: #e9f3e3;
      padding: 0.2rem 1rem;
      border-radius: 40px;
      font-size: 0.8rem;
      font-weight: 600;
      display: inline-block;
      color: #2a6e4b;
    }

    /* seção equipamentos */
    .equip-section {
      background: #e6f0e2;
      border-radius: 48px;
      padding: 2rem 1rem;
      margin: 2rem 0;
    }

    .equip-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.8rem;
      margin-top: 2rem;
    }

    .equip-card {
      background: white;
      border-radius: 28px;
      padding: 1.6rem;
      text-align: center;
      transition: 0.2s;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
      border-bottom: 4px solid #9fc98b;
    }

    .equip-card i {
      font-size: 2.8rem;
      color: #3f8d65;
      margin-bottom: 0.8rem;
    }

    .equip-card h4 {
      font-size: 1.4rem;
      margin: 0.5rem 0;
    }

    .price-badge {
      font-weight: 700;
      background: #e9f3e3;
      display: inline-block;
      padding: 4px 12px;
      border-radius: 80px;
      margin: 0.8rem 0;
      font-size: 0.8rem;
    }

    .feature-list {
      text-align: left;
      margin-top: 1rem;
      font-size: 0.9rem;
      list-style: none;
    }

    .feature-list li {
      margin: 0.4rem 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .feature-list i {
      font-size: 0.9rem;
      color: #2d6a4f;
    }

    /* dicas interativas */
    .tips-box {
      background: #fff6e5;
      border-left: 8px solid #e0b354;
      border-radius: 28px;
      padding: 2rem;
      margin: 3rem 0;
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      justify-content: space-between;
    }

    .tips-text {
      flex: 2;
    }

    .tips-text h3 {
      font-size: 1.8rem;
      color: #b36b1e;
      margin-bottom: 0.5rem;
    }

    .btn-tip {
      background: #e0b354;
      color: #2c2b26;
      border: none;
      font-weight: bold;
    }

    .btn-tip:hover {
      background: #c9952e;
      color: white;
    }

    .random-tip {
      background: #fef7e8;
      padding: 1.2rem;
      border-radius: 28px;
      flex: 1;
      min-width: 220px;
      font-weight: 500;
    }

    /* rodapé */
    footer {
      background: #1a3b2f;
      color: #cfe6cf;
      padding: 2rem 0;
      margin-top: 3rem;
      border-radius: 32px 32px 0 0;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .footer-col p {
      max-width: 280px;
    }

    .social i {
      font-size: 1.6rem;
      margin-right: 1rem;
      color: #cfe6cf;
      transition: 0.2s;
    }

    .social i:hover {
      color: #e0c87c;
    }

    @media (max-width: 780px) {
      .hero-text h1 {
        font-size: 2.2rem;
      }
      .nav-links {
        gap: 1rem;
        margin-top: 0.8rem;
      }
      .nav-flex {
        flex-direction: column;
      }
      .btn-group {
        justify-content: center;
      }
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <div class="container nav-flex">
      <div class="logo">
        <i class="fas fa-leaf"></i>
        <span>CampoSustentável</span>
      </div>
      <ul class="nav-links">
        <li><a href="#solucoes">Soluções</a></li>
        <li><a href="#equipamentos">Equipamentos</a></li>
        <li><a href="#dicas">Dicas verdes</a></li>
        <li><a href="#contato">Contato</a></li>
      </ul>
    </div>
  </nav>

  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <h1>Tecnologia & natureza: o futuro do agro é regenerativo</h1>
        <p>Práticas sustentáveis que aumentam a produtividade, conservam o solo e valorizam o produtor. Descubra equipamentos de baixo impacto e soluções inteligentes para o campo.</p>
        <div class="btn-group">
          <a href="#equipamentos" class="btn"><i class="fas fa-tractor"></i> Ver equipamentos</a>
          <a href="#solucoes" class="btn btn-outline"><i class="fas fa-seedling"></i> Soluções sustentáveis</a>
        </div>
      </div>
      <div class="hero-img">
        <!-- ilustração SVG ou imagem representativa (placeholder com ícone) -->
        <img src="https://placehold.co/500x300/e2f0da/2d6a4f?text=Agricultura+Regenerativa" alt="Campo sustentável" style="background:#cde2c1; object-fit: cover;">
      </div>
    </div>
  </section>

  <div class="container" id="solucoes">
    <h2 class="section-title">🌱 Soluções Sustentáveis para o Agro</h2>
    <p class="section-sub">Práticas que integram conservação ambiental, rentabilidade e eficiência no campo</p>
    <div class="cards-grid">
      <div class="card">
        <div class="card-icon"><i class="fas fa-water"></i></div>
        <h3>Irrigação de Precisão</h3>
        <p>Uso de sensores de umidade e gotejamento inteligente reduzem consumo hídrico em até 50% e evitam desperdícios.</p>
        <span class="tag">Economia Hídrica</span>
      </div>
      <div class="card">
        <div class="card-icon"><i class="fas fa-seedling"></i></div>
        <h3>Integração Lavoura-Pecuária-Floresta (ILPF)</h3>
        <p>Recupera pastagens degradadas, sequestra carbono e diversifica renda. Sistema que imita ecossistemas naturais.</p>
        <span class="tag">Carbono neutro</span>
      </div>
      <div class="card">
        <div class="card-icon"><i class="fas fa-solar-panel"></i></div>
        <h3>Energia Solar Rural</h3>
        <p>Placas fotovoltaicas para bombeamento de água, cercas elétricas e armazenagem. Reduz custos com energia e pegada ecológica.</p>
        <span class="tag">Energia limpa</span>
      </div>
      <div class="card">
        <div class="card-icon"><i class="fas fa-worm"></i></div>
        <h3>Compostagem e Biofertilizantes</h3>
        <p>Aproveitamento de resíduos orgânicos para produção de adubo vivo, eliminando fertilizantes químicos agressivos.</p>
        <span class="tag">Solo vivo</span>
      </div>
    </div>
  </div>

  <div class="container equip-section" id="equipamentos">
    <h2 class="section-title" style="margin-top: 0;">🚜 Equipamentos Sustentáveis Recomendados</h2>
    <p class="section-sub">Tecnologia de baixo impacto, eficiência energética e design para agricultura regenerativa</p>
    <div class="equip-grid">
      <div class="equip-card">
        <i class="fas fa-tachometer-alt"></i>
        <h4>Trator Elétrico Fendt e100</h4>
        <div class="price-badge"><i class="fas fa-bolt"></i> 100% elétrico | 0 emissões</div>
        <ul class="feature-list">
          <li><i class="fas fa-check-circle"></i> Autonomia 5h (carga rápida)</li>
          <li><i class="fas fa-check-circle"></i> Silencioso, ideal para áreas periurbanas</li>
          <li><i class="fas fa-check-circle"></i> Redução de custos com diesel</li>
        </ul>
      </div>
      <div class="equip-card">
        <i class="fas fa-tint"></i>
        <h4>Kit IrrigaInteligente Netafim</h4>
        <div class="price-badge"><i class="fas fa-microchip"></i> IoT + Sensores de solo</div>
        <ul class="feature-list">
          <li><i class="fas fa-check-circle"></i> Economia de água até 55%</li>
          <li><i class="fas fa-check-circle"></i> Controle por App em tempo real</li>
          <li><i class="fas fa-check-circle"></i> Indicado para hortas e fruticultura</li>
        </ul>
      </div>
      <div class="equip-card">
        <i class="fas fa-plug"></i>
        <h4>Roçadora Robótica Solar Ecorobo</h4>
        <div class="price-badge"><i class="fas fa-sun"></i> Energia solar integrada</div>
        <ul class="feature-list">
          <li><i class="fas fa-check-circle"></i> Corte autônomo em pastagens</li>
          <li><i class="fas fa-check-circle"></i> Sem emissão de CO₂</li>
          <li><i class="fas fa-check-circle"></i> Baixa compactação do solo</li>
        </ul>
      </div>
      <div class="equip-card">
        <i class="fas fa-charging-station"></i>
        <h4>Biodigestor Campo+</h4>
        <div class="price-badge"><i class="fas fa-recycle"></i> Conversão de dejetos em biogás</div>
        <ul class="feature-list">
          <li><i class="fas fa-check-circle"></i> Geração de energia e biofertilizante</li>
          <li><i class="fas fa-check-circle"></i> Reduz metano e odor</li>
          <li><i class="fas fa-check-circle"></i> Retorno em até 3 anos</li>
        </ul>
      </div>
    </div>
    <div style="margin-top: 2rem; text-align: center;">
      <a href="#" class="btn" style="background:#2d6a4f;"><i class="fas fa-hand-holding-heart"></i> Solicitar consultoria técnica</a>
    </div>
  </div>

  <!-- seção interativa dicas sustentáveis (javascript) -->
  <div class="container" id="dicas">
    <div class="tips-box">
      <div class="tips-text">
        <h3><i class="fas fa-lightbulb"></i> Dica do dia — Campo Sustentável</h3>
        <p>Pequenas ações diárias geram grandes transformações no agro. Clique no botão e inspire-se com práticas regenerativas!</p>
        <button id="newTipBtn" class="btn btn-tip"><i class="fas fa-sync-alt"></i> Gerar nova dica</button>
      </div>
      <div class="random-tip" id="tipDisplay">
        <i class="fas fa-quote-left"></i> “A rotação de culturas melhora a fertilidade do solo e reduz pragas naturalmente.”
      </div>
    </div>
  </div>

  <!-- seção de contato fictício e rodapé -->
  <footer id="contato">
    <div class="container footer-content">
      <div class="footer-col">
        <h3><i class="fas fa-leaf"></i> CampoSustentável</h3>
        <p>Conectando produtores e tecnologias verdes para um agro mais próspero e equilibrado com o planeta.</p>
      </div>
      <div class="footer-col">
        <h4>Contato</h4>
        <p><i class="fas fa-envelope"></i> sustentabilidade@camposustentavel.agro</p>
        <p><i class="fas fa-phone-alt"></i> +55 (51) 99999-8765</p>
      </div>
      <div class="footer-col social">
        <h4>Redes</h4>
        <a href="#"><i class="fab fa-instagram"></i></a>
        <a href="#"><i class="fab fa-youtube"></i></a>
        <a href="#"><i class="fab fa-linkedin"></i></a>
        <p style="margin-top: 12px;">© 2025 — Soluções para um futuro regenerativo</p>
      </div>
    </div>
  </footer>

  <script>
    // banco de dicas sustentáveis e equipamentos (conteúdo rotativo)
    const tipsArray = [
      "🌾 Integração Lavoura-Pecuária-Floresta: aumenta a biodiversidade e sequestra carbono, além de diversificar a renda.",
      "💧 Gotejamento subterrâneo + mulch orgânico: reduza evaporação e combata plantas invasoras sem herbicidas.",
      "🐝 Plante faixas de flores nativas ao redor das lavouras: atrai polinizadores e controladores biológicos de pragas.",
      "🔋 Use placas solares em galpões e centros de distribuição → economia de até 90% na conta de energia rural.",
      "🌱 Biofertilizante líquido caseiro: cascas de frutas + água + microrganismos eficientes melhora o solo sem químicos.",
      "🚜 Tratores elétricos ou a biometano reduzem drasticamente a pegada de carbono e melhoram saúde do trabalhador.",
      "📱 Monitoramento por drones com NDVI: detecta estresse hídrico e nutrientes antecipadamente, reduz insumos.",
      "♻️ Composteira de alta rotação para resíduos da colheita: produz adubo em 45 dias e evita queimadas.",
      "💨 Captação de água da chuva em barragens subterrâneas: garante irrigação mesmo em períodos de estiagem.",
      "🐄 Sistemas silvipastoris: árvores em pastagens → conforto térmico para o gado e maior produtividade de carne/leite."
    ];

    const tipsElement = document.getElementById('tipDisplay');
    const newTipBtn = document.getElementById('newTipBtn');

    function getRandomTip() {
      const randomIndex = Math.floor(Math.random() * tipsArray.length);
      return tipsArray[randomIndex];
    }

    function updateTip() {
      if (tipsElement) {
        tipsElement.innerHTML = `<i class="fas fa-quote-left"></i> ${getRandomTip()}`;
      }
    }

    if (newTipBtn) {
      newTipBtn.addEventListener('click', updateTip);
    }

    // Adiciona um toque dinâmico nos cards de equipamento: simulação de interatividade (detalhe extra)
    const equipCards = document.querySelectorAll('.equip-card');
    equipCards.forEach(card => {
      card.addEventListener('click', () => {
        // apenas um efeito leve sem overload, exibe tooltip-like
        const equipName = card.querySelector('h4')?.innerText || 'equipamento';
        // criamos um feedback visual: alerta não intrusivo? melhor um console amigável opcional
        // mas para não poluir, apenas uma pequena animação de escala
        card.style.transform = 'scale(0.98)';
        setTimeout(() => { card.style.transform = ''; }, 150);
        // Pode opcionalmente mostrar uma notificação sutil (mas sem atrapalhar experiência)
        if (window.innerWidth > 720) {
          // apenas simula ação amigável; nada agressivo
          console.log(`Dica do ${equipName}: consulte um especialista para melhor adaptação à sua região.`);
        }
      });
    });

    // scroll suave para navegação
    document.querySelectorAll('.nav-links a, .btn[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const targetId = this.getAttribute('href');
        if (targetId && targetId !== '#') {
          const targetElement = document.querySelector(targetId);
          if (targetElement) {
            e.preventDefault();
            targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  </script>
</body>
</html>